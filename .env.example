# Copy this file to .env (in the same folder) and put your own key in it.
# .env is listed in .gitignore, so your key is never uploaded to GitHub.
# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional settings (defaults shown)
# ATL_LLM_MODEL=openai/gpt-oss-20b
# ATL_LLM_REASONING_EFFORT=low
# ATL_LLM_BASE_URL=https://api.groq.com/openai/v1
